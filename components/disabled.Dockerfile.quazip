FROM kmpm/fritzbuild-base:latest


ARG QUAZIP_VERSION=1.4
ARG NPROC=2

RUN set -xe \
    && wget -q -O - https://github.com/stachenov/quazip/archive/refs/tags/v${QUAZIP_VERSION}.tar.gz | tar xz \
    && mv quazip-${QUAZIP_VERSION} quazip_qt6 \
    && mkdir quazip_qt6/build \
    && cd quazip_qt6/build \
    && cmake -D QUAZIP_QT_MAJOR_VERSION=6 .. \
    && cmake --build . -- -j2

RUN set -xe \
    && sudo mkdir -p /deb \
    && cd quazip_qt6/build \
    && sudo checkinstall \
        --install=no \
        --default \
        --nodoc \
        --pkgname=libquazip6 \
        --pkgversion=${QUAZIP_VERSION} \
        --pkgrelease=fritzing1 \
        --pkglicense=LGPL \
        --pakdir /deb \
        -D make install 